/* =====================================================
   TEMA SCURO â€” Safety Test Manager V2
   Design System: Indigo / Slate / Glass â€” Dark Variant
   Superfici layered con alto contrasto
   ===================================================== */

/* â”€â”€â”€ VARIABILI DI RIFERIMENTO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
   Superficie 0  (sfondo app):  #0c1222
   Superficie 1  (card/panel):  #131c2e
   Superficie 2  (elevated):    #1a2540
   Bordo base:                  #253352
   Bordo hover:                 #3a4f72
   Bordo focus:                 #818cf8 (indigo-400)
   Testo primario:              #eef2ff
   Testo secondario:            #cbd5e1
   Testo terziario/muted:       #7c8da5
   Accent primario:             #818cf8 (indigo-400)
   Accent hover:                #a5b4fc (indigo-300)
   Accent bg:                   rgba(99,102,241,0.15)
   Success:                     #34d399 (emerald-400)
   Danger:                      #f87171 (red-400)
   Warning:                     #fbbf24 (amber-400)
   â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

/* === BASE === */
QDialog, QMainWindow, QWidget {
    background-color: #0c1222;
    color: #eef2ff;
    font-family: "Segoe UI", "Inter", "SF Pro Display", system-ui, sans-serif;
    font-size: 14px;
}

/* === TAB WIDGET === */
QTabWidget::pane {
    border: 1px solid #253352;
    border-radius: 14px;
    background-color: #131c2e;
    padding: 0px;
    margin-top: -1px;
}

QTabBar {
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: #7c8da5;
    padding: 12px 24px;
    margin-right: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 600;
    font-size: 13px;
    min-width: 120px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    background-color: #131c2e;
    color: #a5b4fc;
    border-bottom: 3px solid #818cf8;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #1a2540;
    color: #cbd5e1;
    border-bottom: 2px solid #4f46e5;
}

/* === MENU BAR === */
QMenuBar {
    background-color: #0c1222;
    border-bottom: 1px solid #253352;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 600;
    color: #cbd5e1;
    min-height: 36px;
    spacing: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 16px;
    border-radius: 8px;
    margin: 2px 1px;
    color: #7c8da5;
}

QMenuBar::item:selected {
    background-color: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
}

QMenuBar::item:pressed {
    background-color: rgba(99, 102, 241, 0.25);
    color: #c7d2fe;
}

/* === MENU DROPDOWN === */
QMenu {
    background-color: #131c2e;
    border: 1px solid #253352;
    border-radius: 12px;
    padding: 6px;
    font-size: 13px;
    color: #cbd5e1;
}

QMenu::item {
    padding: 10px 24px 10px 32px;
    border-radius: 8px;
    margin: 1px 0px;
    color: #7c8da5;
    min-width: 200px;
}

QMenu::item:selected {
    background-color: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    font-weight: 600;
}

QMenu::item:pressed {
    background-color: rgba(99, 102, 241, 0.3);
    color: #c7d2fe;
}

QMenu::item:disabled {
    color: #475569;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #253352;
    margin: 6px 8px;
}

QMenu::icon {
    margin-left: 8px;
    margin-right: 8px;
}

/* === LABEL === */
QLabel {
    color: #eef2ff;
    font-size: 14px;
    padding: 0;
    background-color: transparent;
    line-height: 1.5;
}

QLabel#headerTitle {
    font-size: 22px;
    font-weight: 800;
    color: #f1f5f9;
    padding: 2px 0;
    letter-spacing: -0.3px;
}

QLabel#headerSubtitle {
    font-size: 13px;
    color: #7c8da5;
    font-weight: 400;
}

/* === INPUT FIELDS === */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QTextEdit, QPlainTextEdit, QDateEdit {
    border: 1px solid #253352;
    border-radius: 10px;
    padding: 10px 14px;
    background-color: #131c2e;
    font-size: 14px;
    selection-background-color: #6366f1;
    selection-color: white;
    margin-bottom: 6px;
    color: #eef2ff;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QDateEdit:focus {
    border: 2px solid #818cf8;
    padding: 9px 13px;
    background-color: #0f1728;
    outline: none;
}

QLineEdit:hover:!focus, QComboBox:hover:!focus, QDoubleSpinBox:hover:!focus, QSpinBox:hover:!focus, QTextEdit:hover:!focus, QPlainTextEdit:hover:!focus, QDateEdit:hover:!focus {
    border: 1px solid #3a4f72;
}

QLineEdit:disabled, QComboBox:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QDateEdit:disabled {
    background-color: #0f1728;
    color: #475569;
    border-color: #1e2d48;
}

QLineEdit::placeholder {
    color: #475569;
}

/* === COMBOBOX === */
QComboBox::drop-down {
    border: none;
    width: 32px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #7c8da5;
    width: 0px;
    height: 0px;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    border: 1px solid #253352;
    border-radius: 10px;
    background-color: #131c2e;
    selection-background-color: rgba(99, 102, 241, 0.25);
    selection-color: #a5b4fc;
    padding: 4px;
    color: #cbd5e1;
    outline: none;
}

QComboBox QAbstractItemView::item {
    background-color: #131c2e;
    color: #cbd5e1;
    padding: 10px 12px;
    border: none;
    border-radius: 6px;
    min-height: 26px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #1a2540;
    color: #eef2ff;
}

/* === TABELLE === */
QTableWidget, QTableView {
    background-color: #131c2e;
    border: 1px solid #253352;
    border-radius: 14px;
    gridline-color: #1e2d48;
    font-size: 13px;
    alternate-background-color: #0f1728;
    selection-background-color: rgba(99, 102, 241, 0.2);
    selection-color: #ffffff;
    outline: none;
    color: #eef2ff;
}

QTableWidget::item, QTableView::item {
    padding: 8px 10px;
    border: none;
    color: #cbd5e1;
    border-bottom: 1px solid #1e2d48;
}

QTableWidget#deviceTable::item:selected {
    background-color: rgba(99, 102, 241, 0.3);
    font-weight: 600;
}

QTableWidget#deviceTable::item:hover {
    background-color: #1a2540;
}

QTableWidget#deviceTable::item:hover:selected {
    background-color: rgba(99, 102, 241, 0.35);
    font-weight: 600;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgba(99, 102, 241, 0.3);
    color: #ffffff;
    font-weight: 600;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #1a2540;
}

QTableWidget::item:hover:selected, QTableView::item:hover:selected {
    background-color: rgba(99, 102, 241, 0.35);
    color: #ffffff;
    font-weight: 600;
}

QTableWidget::item:alternate, QTableView::item:alternate {
    background-color: #0f1728;
}

QTableWidget::item:alternate:selected, QTableView::item:alternate:selected {
    background-color: rgba(99, 102, 241, 0.3);
}

/* === HEADER TABELLE === */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #1a2540;
    color: #7c8da5;
    padding: 10px 10px;
    border: none;
    border-right: 1px solid #253352;
    border-bottom: 2px solid #253352;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-height: 20px;
}

QHeaderView::section:first {
    border-top-left-radius: 14px;
}

QHeaderView::section:last {
    border-top-right-radius: 14px;
    border-right: none;
}

QHeaderView::section:hover {
    background-color: #253352;
    color: #a5b4fc;
    border-bottom: 2px solid #6366f1;
}

QHeaderView::section:pressed {
    background-color: #2d3f5f;
    color: #c7d2fe;
}

/* === PULSANTI === */
/* === PULSANTI (DARK)
   Stile: glass semitrasparente + bordo colorato + testo chiaro luminoso */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(99, 102, 241, 0.22),
                                stop:1 rgba(79, 70, 229, 0.18));
    color: #c7d2fe;
    border: 2px solid rgba(165, 180, 252, 0.45);
    border-radius: 14px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
    min-height: 38px;
    min-width: 90px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(99, 102, 241, 0.35),
                                stop:1 rgba(79, 70, 229, 0.28));
    border-color: rgba(165, 180, 252, 0.70);
    color: #e0e7ff;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(79, 70, 229, 0.40),
                                stop:1 rgba(67, 56, 202, 0.35));
    border-color: #818cf8;
}

QPushButton:focus {
    outline: none;
    border: 2px solid #818cf8;
    padding: 9px 19px;
}

QPushButton:disabled {
    background: rgba(37, 51, 82, 0.50);
    color: #475569;
    border-color: rgba(51, 71, 102, 0.40);
}

QPushButton[homeIconButton="true"] {
    min-width: 38px;
    min-height: 38px;
    max-width: 42px;
    max-height: 42px;
    padding: 0px;
    border-radius: 12px;
}

QPushButton#primaryButton[homeIconButton="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6366f1,
                                stop:1 #4f46e5);
    border: 1px solid #818cf8;
}

QPushButton#primaryButton[homeIconButton="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #818cf8,
                                stop:1 #6366f1);
    border: 1px solid #a5b4fc;
}

QPushButton#primaryButton[homeIconButton="true"]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #4f46e5,
                                stop:1 #4338ca);
}

QPushButton#qrHomeButton[homeIconButton="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #8b5cf6,
                                stop:1 #7c3aed);
    border: 1px solid #a78bfa;
}

QPushButton#qrHomeButton[homeIconButton="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #a78bfa,
                                stop:1 #8b5cf6);
    border: 1px solid #c4b5fd;
}

QPushButton#qrHomeButton[homeIconButton="true"]:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #22c55e,
                                stop:1 #16a34a);
    border: 1px solid #4ade80;
}

/* Pulsante Aggiungi (Verde) */
QPushButton#addButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #10b981,
                                stop:1 #059669);
    padding: 0px;
    min-height: 38px;
    min-width: 38px;
    max-height: 38px;
    max-width: 38px;
    border-radius: 19px;
}

QPushButton#addButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #34d399,
                                stop:1 #10b981);
}

QPushButton#addButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #059669,
                                stop:1 #047857);
}

QPushButton#addButton:focus {
    border: 2px solid #6ee7b7;
    padding: 0px;
}

/* Pulsante Calendario Filtro */
QPushButton#calendarFilterButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(51, 65, 85, 0.60),
                                stop:1 rgba(71, 85, 105, 0.50));
    color: #cbd5e1;
    border: 2px solid rgba(148, 163, 184, 0.35);
    padding: 0px;
    max-height: 42px;
    max-width: 42px;
    min-height: 42px;
    min-width: 42px;
    border-radius: 12px;
}

QPushButton#calendarFilterButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(71, 85, 105, 0.70),
                                stop:1 rgba(100, 116, 139, 0.60));
    border-color: rgba(148, 163, 184, 0.60);
    color: #e2e8f0;
}

QPushButton#calendarFilterButton:pressed {
    background: rgba(30, 41, 59, 0.60);
    border-color: #94a3b8;
}

QPushButton#calendarFilterButton:focus {
    border: 2px solid #94a3b8;
    padding: 0px;
}

/* Pulsante Verifica Automatica (Emerald glass) */
QPushButton#autoButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.22),
                                stop:1 rgba(5, 150, 105, 0.18));
    color: #6ee7b7;
    border: 2px solid rgba(52, 211, 153, 0.45);
    padding: 10px 20px;
    min-height: 38px;
    min-width: 90px;
}

QPushButton#autoButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.35),
                                stop:1 rgba(5, 150, 105, 0.28));
    border-color: rgba(52, 211, 153, 0.70);
    color: #a7f3d0;
}

QPushButton#autoButton:pressed {
    background: rgba(5, 150, 105, 0.35);
    border-color: #34d399;
}

QPushButton#autoButton:focus {
    border: 2px solid #34d399;
    padding: 9px 19px;
}

/* Pulsante Modifica (Violet glass) */
QPushButton#editButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(139, 92, 246, 0.22),
                                stop:1 rgba(124, 58, 237, 0.18));
    color: #c4b5fd;
    border: 2px solid rgba(196, 181, 253, 0.45);
}

QPushButton#editButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(139, 92, 246, 0.35),
                                stop:1 rgba(124, 58, 237, 0.28));
    border-color: rgba(196, 181, 253, 0.70);
    color: #ddd6fe;
}

QPushButton#editButton:pressed {
    background: rgba(124, 58, 237, 0.35);
    border-color: #a78bfa;
}

QPushButton#editButton:focus {
    border: 2px solid #a78bfa;
    padding: 9px 19px;
}

/* Pulsante Elimina (Rose glass) */
QPushButton#deleteButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(239, 68, 68, 0.22),
                                stop:1 rgba(220, 38, 38, 0.18));
    color: #fca5a5;
    border: 2px solid rgba(252, 165, 165, 0.45);
}

QPushButton#deleteButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(239, 68, 68, 0.35),
                                stop:1 rgba(220, 38, 38, 0.28));
    border-color: rgba(248, 113, 113, 0.70);
    color: #fecaca;
}

QPushButton#deleteButton:pressed {
    background: rgba(185, 28, 28, 0.35);
    border-color: #f87171;
}

QPushButton#deleteButton:focus {
    border: 2px solid #f87171;
    padding: 9px 19px;
}

/* Pulsante Secondario (Slate glass) */
QPushButton#secondaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(51, 65, 85, 0.60),
                                stop:1 rgba(71, 85, 105, 0.50));
    color: #cbd5e1;
    border: 2px solid rgba(148, 163, 184, 0.35);
}

QPushButton#secondaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(71, 85, 105, 0.70),
                                stop:1 rgba(100, 116, 139, 0.60));
    border-color: rgba(148, 163, 184, 0.60);
    color: #e2e8f0;
}

QPushButton#secondaryButton:pressed {
    background: rgba(30, 41, 59, 0.60);
    border-color: #94a3b8;
}

QPushButton#secondaryButton:focus {
    border: 2px solid #94a3b8;
    padding: 9px 19px;
}

/* Pulsante Warning (Amber glass) */
QPushButton#warningButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(245, 158, 11, 0.22),
                                stop:1 rgba(217, 119, 6, 0.18));
    color: #fde68a;
    border: 2px solid rgba(252, 211, 77, 0.45);
}

QPushButton#warningButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(245, 158, 11, 0.35),
                                stop:1 rgba(217, 119, 6, 0.28));
    border-color: rgba(251, 191, 36, 0.70);
    color: #fef3c7;
}

QPushButton#warningButton:pressed {
    background: rgba(180, 83, 9, 0.35);
    border-color: #f59e0b;
}

QPushButton#warningButton:focus {
    border: 2px solid #f59e0b;
    padding: 9px 19px;
}

/* === GROUPBOX === */
QGroupBox {
    font-weight: 600;
    font-size: 14px;
    color: #eef2ff;
    border: 1px solid #253352;
    border-radius: 14px;
    margin-top: 16px;
    padding: 18px 14px 14px 14px;
    background-color: #131c2e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    left: 16px;
    background-color: #1a2540;
    color: #a5b4fc;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
}

QWidget#homeSidebar,
QWidget#homeWorkspace,
QWidget#selectionWorkspace {
    background-color: transparent;
}

QFrame#homeHeroCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #131c2e,
                                stop:0.55 #16233b,
                                stop:1 #1a2b4b);
    border: 1px solid #334766;
    border-radius: 20px;
}

QLabel#homeHeroTitle {
    font-size: 24px;
    font-weight: 800;
    color: #eef2ff;
    letter-spacing: -0.4px;
}

QLabel#homeHeroSubtitle {
    font-size: 13px;
    color: #9fb0c8;
    line-height: 1.45;
}

QLabel#homeHeroMetaBadge {
    background-color: rgba(129, 140, 248, 0.14) !important;
    color: #c7d2fe;
    border: 1px solid rgba(129, 140, 248, 0.22);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#homeHeroHint {
    background-color: rgba(12, 18, 34, 0.34) !important;
    color: #dbe5f5;
    border: 1px solid #334766;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 600;
}

QGroupBox#statsGroupBox,
QGroupBox#homeActionsGroup {
    border-radius: 18px;
}

/* === BADGE CONTESTO FLUSSO GUIDATO (DARK) === */
QLabel#summaryContextBadge {
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 2px;
    line-height: 1.4;
}

QLabel#summaryContextBadge[state="idle"] {
    background-color: rgba(148, 163, 184, 0.12) !important;
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.20);
}

QLabel#summaryContextBadge[state="step1"] {
    background-color: rgba(96, 165, 250, 0.15) !important;
    color: #93c5fd;
    border: 1px solid rgba(96, 165, 250, 0.30);
}

QLabel#summaryContextBadge[state="step2"] {
    background-color: rgba(167, 139, 250, 0.15) !important;
    color: #c4b5fd;
    border: 1px solid rgba(167, 139, 250, 0.30);
}

QLabel#summaryContextBadge[state="step3"] {
    background-color: rgba(251, 146, 60, 0.15) !important;
    color: #fdba74;
    border: 1px solid rgba(251, 146, 60, 0.30);
}

QLabel#summaryContextBadge[state="ready"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(52, 211, 153, 0.20),
                                stop:1 rgba(16, 185, 129, 0.15)) !important;
    color: #6ee7b7;
    border: 1px solid rgba(52, 211, 153, 0.35);
    font-weight: 800;
}

QLabel#summaryContextBadge[state="warning"] {
    background-color: rgba(251, 191, 36, 0.14) !important;
    color: #fde68a;
    border: 1px solid rgba(251, 191, 36, 0.28);
}

/* === STATS CARDS DARK === */

QLabel#statsIntroLabel {
    color: #8fa1bd;
    font-size: 12px;
    line-height: 1.4;
}

QLabel#statsTimestampLabel {
    color: #8fa1bd;
    font-size: 10px;
    font-weight: 600;
    padding-right: 4px;
}

QLabel#statsCardPrimary,
QLabel#statsCardSuccess,
QLabel#statsCardDanger {
    border-radius: 14px;
    padding: 12px 16px;
    border: 2px solid transparent;
    font-weight: 700;
    font-size: 13px;
}

QLabel#statsCardPrimary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(59, 130, 246, 0.22),
                                stop:1 rgba(99, 102, 241, 0.16)) !important;
    color: #bfdbfe;
    border-color: rgba(96, 165, 250, 0.35);
}

QLabel#statsCardPrimary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(59, 130, 246, 0.32),
                                stop:1 rgba(99, 102, 241, 0.24)) !important;
    border-color: rgba(129, 140, 248, 0.55);
}

QLabel#statsCardSuccess {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.22),
                                stop:1 rgba(52, 211, 153, 0.16)) !important;
    color: #6ee7b7;
    border-color: rgba(52, 211, 153, 0.35);
}

QLabel#statsCardSuccess:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.32),
                                stop:1 rgba(52, 211, 153, 0.24)) !important;
    border-color: rgba(52, 211, 153, 0.55);
}

QLabel#statsCardDanger {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(239, 68, 68, 0.22),
                                stop:1 rgba(248, 113, 113, 0.16)) !important;
    color: #fca5a5;
    border-color: rgba(248, 113, 113, 0.35);
}

QLabel#statsCardDanger:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(239, 68, 68, 0.32),
                                stop:1 rgba(248, 113, 113, 0.24)) !important;
    border-color: rgba(248, 113, 113, 0.55);
}

/* === SCROLLBAR === */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background-color: #334766;
    border-radius: 4px;
    min-height: 32px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f6078;
}

QScrollBar::handle:vertical:pressed {
    background-color: #64768f;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    width: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: #334766;
    border-radius: 4px;
    min-width: 32px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f6078;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #64768f;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}

/* === WIDGET DENTRO TABELLE === */
QTableWidget QLineEdit,
QTableWidget QComboBox,
QTableWidget QDoubleSpinBox,
QTableWidget QSpinBox,
QTableView QLineEdit,
QTableView QComboBox,
QTableView QDoubleSpinBox,
QTableView QSpinBox {
    margin: 2px;
    padding: 4px 6px;
    font-size: 12px;
    border: 1px solid #253352;
    border-radius: 6px;
    background-color: #131c2e;
    color: #eef2ff;
    min-height: 14px;
}

QTableWidget QLineEdit:focus,
QTableWidget QComboBox:focus,
QTableWidget QDoubleSpinBox:focus,
QTableWidget QSpinBox:focus,
QTableView QLineEdit:focus,
QTableView QComboBox:focus,
QTableView QDoubleSpinBox:focus,
QTableView QSpinBox:focus {
    border: 2px solid #818cf8;
    background-color: #0f1728;
}

QTableWidget QLineEdit:hover,
QTableWidget QComboBox:hover,
QTableWidget QDoubleSpinBox:hover,
QTableWidget QSpinBox:hover,
QTableView QLineEdit:hover,
QTableView QComboBox:hover,
QTableView QDoubleSpinBox:hover,
QTableView QSpinBox:hover {
    border: 1px solid #3a4f72;
}

/* === LISTWIDGET === */
QListWidget {
    background-color: #131c2e;
    border: 1px solid #253352;
    border-radius: 12px;
    color: #cbd5e1;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid #1e2d48;
    color: #cbd5e1;
    border-radius: 6px;
    margin: 1px;
}

QListWidget::item:hover {
    background: #1a2540;
    color: #eef2ff;
}

QListWidget::item:selected {
    background: #6366f1;
    color: #ffffff;
    font-weight: 700;
}

/* === PANNELLI LATERALI === */
QWidget#selectionColumnCard {
    background-color: #131c2e;
    border: 1px solid #253352;
    border-radius: 16px;
    border-top: 3px solid #4f46e5;
}

QWidget#selectionColumnCard[columnStep="1"] {
    border-top: 3px solid #6366f1;
}
QWidget#selectionColumnCard[columnStep="2"] {
    border-top: 3px solid #d97706;
}
QWidget#selectionColumnCard[columnStep="3"] {
    border-top: 3px solid #059669;
}

QWidget#selectionColumnCard:disabled,
QWidget#selectionColumnCard[locked="true"] {
    background-color: #0f172a;
    border: 1px solid #1e2d48;
    border-top: 3px solid #1e2d48;
    opacity: 0.6;
}

/* Step badge numerato */
QLabel#stepBadge {
    border-radius: 12px;
    font-size: 12px;
    font-weight: 800;
    color: #ffffff;
}
QLabel#stepBadge[stepColor="blue"] {
    background-color: #4f46e5;
}
QLabel#stepBadge[stepColor="orange"] {
    background-color: #d97706;
}
QLabel#stepBadge[stepColor="green"] {
    background-color: #059669;
}

/* Titolo colonna */
QLabel#panelColumnTitle {
    font-size: 11px;
    font-weight: 800;
    color: #8fa1bd;
    letter-spacing: 1px;
}

/* Placeholder colonna bloccata */
QLabel#columnPlaceholder {
    color: #334766;
    font-size: 13px;
    font-style: italic;
    padding: 32px 16px;
}

QLabel#panelHeader {
    font-size: 15px;
    color: #dbe5ff;
    padding: 4px 8px 0px 8px;
    font-weight: 800;
}

QLabel#panelSubheader {
    font-size: 12px;
    color: #8fa1bd;
    padding: 0px 8px 6px 8px;
}

QListWidget#panelListWidget {
    border: 1px solid #253352;
    border-radius: 14px;
    background: #10192d;
    font-size: 13px;
    color: #cbd5e1;
    padding: 6px;
}

QListWidget#panelListWidget::item {
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #cbd5e1;
    margin: 2px 0px;
}

QListWidget#panelListWidget::item:hover {
    background: #1a2540;
    color: #eef2ff;
    border: 1px solid #334766;
}

QListWidget#panelListWidget::item:selected {
    background: rgba(99, 102, 241, 0.24);
    color: #ffffff;
    border: 1px solid #818cf8;
    font-weight: 700;
}

QLabel#panelCountLabel {
    color: #8fa1bd;
    font-size: 12px;
    padding: 2px 8px 0px 8px;
}

/* === FILTER CHIPS BAR — DARK === */
QFrame#filterChipsBar {
    background: #131c2e;
    border: 1px solid #253352;
    border-radius: 16px;
    min-height: 56px;
    max-height: 60px;
}

QPushButton#filterChip {
    background: rgba(30,45,75,0.8);
    border: 1.5px solid #334766;
    border-radius: 20px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    min-height: 34px;
}
QPushButton#filterChip:hover {
    background: rgba(99,102,241,0.18);
    border-color: rgba(165,180,252,0.5);
    color: #c7d2fe;
}
QPushButton#filterChip[chipActive="true"] {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 rgba(99,102,241,0.28), stop:1 rgba(139,92,246,0.22));
    border: 2px solid #818cf8;
    color: #e0e7ff;
    font-weight: 700;
}
QPushButton#filterChip:disabled {
    background: rgba(15,23,42,0.6);
    border-color: #1e2d48;
    color: #475569;
}

QLabel#chipArrow {
    color: #334766;
    font-size: 18px;
    font-weight: 300;
    background: transparent;
    padding: 0 2px;
}

QPushButton#chipsResetButton {
    background: rgba(220,38,38,0.2);
    border: 1px solid rgba(248,113,113,0.4);
    border-radius: 13px;
    color: #f87171;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
}
QPushButton#chipsResetButton:hover {
    background: rgba(220,38,38,0.3);
}

QFrame#chipsDevicePanel {
    background: transparent;
    border: none;
}

/* Popup picker */
QDialog#pickerPopup {
    background: #131c2e;
    border: 1px solid #253352;
    border-radius: 14px;
}
QListWidget#pickerList {
    border: 1px solid #253352;
    border-radius: 10px;
    background: #0f172a;
    font-size: 13px;
    color: #cbd5e1;
    padding: 4px;
}
QListWidget#pickerList::item {
    padding: 10px 14px;
    border-radius: 8px;
    margin: 1px 0;
    color: #cbd5e1;
}
QListWidget#pickerList::item:hover {
    background: #1a2540;
    color: #eef2ff;
}
QListWidget#pickerList::item:selected {
    background: rgba(99,102,241,0.24);
    color: #ffffff;
    font-weight: 700;
}
QLineEdit#pickerSearch {
    border: 1px solid #253352;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 13px;
    background: #0f172a;
    color: #cbd5e1;
}

/* === DRILL-DOWN — DARK === */
QFrame#drillBreadcrumbBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1a1f35, stop:1 #141829);
    border-bottom: 2px solid #6366f1;
    min-height: 54px;
    max-height: 58px;
    border-radius: 0;
}

QPushButton#drillCrumb {
    background: rgba(99,102,241,0.15);
    border: 1px solid rgba(99,102,241,0.30);
    color: #a5b4fc;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 14px;
    min-height: 28px;
    border-radius: 14px;
    text-decoration: none;
    letter-spacing: 0.2px;
}
QPushButton#drillCrumb:hover {
    background: rgba(99,102,241,0.28);
    border-color: #818cf8;
    color: #c7d2fe;
}
QPushButton#drillCrumb:pressed {
    background: rgba(99,102,241,0.40);
}

QLabel#drillCrumbArrow {
    color: #6366f1;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
    padding: 0 3px;
}

QLabel#drillCrumbCurrent, QPushButton#drillCrumbCurrent {
    color: #a5b4fc;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 14px;
    min-height: 28px;
    background: rgba(99,102,241,0.15);
    border: 1px solid rgba(99,102,241,0.30);
    border-radius: 14px;
    letter-spacing: 0.2px;
}
QPushButton#drillCrumbCurrent:hover {
    background: rgba(99,102,241,0.15);
    border: 1px solid rgba(99,102,241,0.30);
}

QPushButton#drillCrumbSelected {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    padding: 5px 14px;
    min-height: 28px;
    background: #6366f1;
    border: 1px solid #818cf8;
    border-radius: 14px;
    letter-spacing: 0.2px;
}
QPushButton#drillCrumbSelected:hover {
    background: #6366f1;
    border: 1px solid #818cf8;
}

QLabel#drillCountLabel {
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    background: #6366f1;
    padding: 5px 12px;
    min-height: 28px;
    border-radius: 14px;
    letter-spacing: 0.3px;
}

QWidget#drillPage {
    background: transparent;
}

QListWidget#drillListWidget {
    border: none;
    background: #0d1526;
    font-size: 13px;
    color: #cbd5e1;
    padding: 4px 6px;
    outline: 0;
}
QListWidget#drillListWidget::item {
    padding: 2px 0;
    border-bottom: 1px solid #1a2540;
    border-radius: 0;
    margin: 0;
    color: #cbd5e1;
}
QListWidget#drillListWidget::item:hover {
    background: #1a2540;
    color: #eef2ff;
    border-bottom: 1px solid #253352;
}
QListWidget#drillListWidget::item:selected {
    background: rgba(99,102,241,0.2);
    color: #e0e7ff;
    border-left: 3px solid #818cf8;
    font-weight: 700;
    border-bottom: 1px solid #334766;
}

QLabel#drillCountInline {
    color: #64748b;
    font-size: 12px;
    padding: 4px 6px 0;
}

/* Device row widget (drill-down lista dispositivi) */
QWidget#deviceRowWidget {
    background: transparent;
}
QLabel#deviceRowTitle {
    font-size: 13px;
    font-weight: 700;
    color: #e2e8f0;
    background: transparent;
}
QLabel#deviceRowSub {
    font-size: 12px;
    color: #94a3b8;
    background: transparent;
}
QLabel#deviceRowInv {
    font-size: 11px;
    color: #475569;
    background: transparent;
}
QLabel#deviceStatusBadge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(220,38,38,0.2);
    color: #f87171;
    border: 1px solid rgba(248,113,113,0.3);
}
QLabel#deviceDeptBadge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(16,185,129,0.15);
    color: #34d399;
    border: 1px solid rgba(52,211,153,0.3);
}

QLabel#deviceInvBadge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
}
QLabel#deviceInvBadge[invType="ams"] {
    background: rgba(29,78,216,0.2);
    color: #93c5fd;
    border: 1px solid rgba(147,197,253,0.3);
}
QLabel#deviceInvBadge[invType="customer"] {
    background: rgba(124,58,237,0.2);
    color: #c4b5fd;
    border: 1px solid rgba(196,181,253,0.3);
}

/* === CUSTOMER ROW WIDGET — DARK === */
QWidget#customerRowWidget {
    background: transparent;
}
QLabel#customerRowTitle {
    font-size: 13px;
    font-weight: 700;
    color: #e2e8f0;
    background: transparent;
}
QListWidget#drillListWidget::item:selected QLabel#customerRowTitle {
    color: #a5b4fc;
}
QLabel#customerRowSub {
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}
QLabel#customerCountBadge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
}
QLabel#customerCountBadge[badgeType="dest"] {
    background: rgba(22,163,74,0.15);
    color: #86efac;
    border: 1px solid rgba(134,239,172,0.25);
}
QLabel#customerCountBadge[badgeType="dev"] {
    background: rgba(29,78,216,0.2);
    color: #93c5fd;
    border: 1px solid rgba(147,197,253,0.25);
}

/* === DESTINATION ROW WIDGET — DARK === */
QWidget#destinationRowWidget {
    background: transparent;
}
QLabel#destinationRowTitle {
    font-size: 13px;
    font-weight: 700;
    color: #e2e8f0;
    background: transparent;
}
QListWidget#drillListWidget::item:selected QLabel#destinationRowTitle {
    color: #a5b4fc;
}
QLabel#destinationRowSub {
    font-size: 11px;
    color: #94a3b8;
    background: transparent;
}
QLabel#destinationCountBadge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(29,78,216,0.2);
    color: #93c5fd;
    border: 1px solid rgba(147,197,253,0.25);
}

/* === STICKY ACTION BAR (Opzione C) — DARK === */
QFrame#stickyActionBar {
    background: #131c2e;
    border: 1px solid #253352;
    border-radius: 16px;
}

QFrame#flowBreadcrumbBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0f1728, stop:1 #131c2e);
    border-bottom: 1px solid #253352;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    min-height: 36px;
}

QLabel#breadcrumbStep {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid transparent;
}

QLabel#breadcrumbStep[state="pending"] {
    background: rgba(30, 41, 59, 0.60);
    color: #475569;
    border-color: rgba(51, 71, 102, 0.50);
}

QLabel#breadcrumbStep[state="active"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(99, 102, 241, 0.30),
                                stop:1 rgba(79, 70, 229, 0.22));
    color: #c7d2fe;
    border-color: rgba(165, 180, 252, 0.45);
}

QLabel#breadcrumbStep[state="locked"] {
    background: transparent;
    color: #334155;
    border-color: transparent;
}

QLabel#breadcrumbArrow {
    color: #334155;
    font-size: 16px;
    font-weight: 400;
    padding: 0 2px;
    background: transparent;
    border: none;
}

QLabel#sessionStatusBadge {
    font-size: 12px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 20px;
    border: 1px solid transparent;
}

QLabel#sessionStatusBadge[state="ready"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(16, 185, 129, 0.22),
                                stop:1 rgba(5, 150, 105, 0.18));
    color: #6ee7b7;
    border-color: rgba(52, 211, 153, 0.40);
}

QLabel#sessionStatusBadge[state="warning"] {
    background: rgba(245, 158, 11, 0.15);
    color: #fde68a;
    border-color: rgba(252, 211, 77, 0.35);
}

/* === SUMMARY GROUPBOX === */
QGroupBox#summaryGroupBox {
    font-size: 14px;
    font-weight: 700;
    border: 1px solid #4f46e5;
    border-radius: 14px;
    margin-top: 14px;
    padding-top: 18px;
    background: #131c2e;
    color: #eef2ff;
}

QGroupBox#summaryGroupBox::title {
    color: #a5b4fc;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    background: #1a2540;
    border-radius: 8px;
    font-weight: 700;
}

QGroupBox#searchGroupBox {
    border: 1px solid #4f46e5;
    border-radius: 14px;
    padding: 16px;
    margin-top: 12px;
    background-color: #131c2e;
    color: #eef2ff;
}

QGroupBox#searchGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    background-color: #1a2540;
    color: #a5b4fc;
    font-weight: 700;
    font-size: 14px;
}

QFrame#summaryFrame {
    background: #131c2e;
    border: 1px solid #253352;
    border-radius: 16px;
    padding: 10px;
    color: #eef2ff;
}

/* === FRAME HEADER === */
QFrame#headerFrame {
    background-color: #131c2e;
    border-radius: 14px;
    padding: 14px;
    border: 1px solid #253352;
}

QLabel#headerTitle {
    border: none;
    font-size: 20px;
    font-weight: 800;
    color: #a5b4fc;
    letter-spacing: -0.3px;
}

QLabel#headerSubtitle {
    border: none;
    margin-top: 2px;
    font-size: 12px;
    color: #7c8da5;
}

QLabel#userInfoLabel {
    font-size: 12px;
    color: #cbd5e1;
    font-weight: 600;
    background-color: #1a2540 !important;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid #253352;
}

QLabel#sectionLabel {
    background-color: #1a2540 !important;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
    font-weight: 600;
    color: #cbd5e1;
    font-size: 13px;
}

/* === SUMMARY LABEL STATES === */
QFrame#summaryFrame QLabel {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
    padding: 0px;
}

QLabel#sectionDividerLabel {
    color: #9fb0c8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 2px 2px 0px 2px;
}

QFrame#actionStripFrame {
    background: #10192d;
    border: 1px solid #253352;
    border-radius: 16px;
}

QLabel#summaryLabel {
    color: #7c8da5;
    font-size: 14px;
    font-style: italic;
    background-color: transparent !important;
    background: transparent !important;
}

QLabel#summaryLabel[state="selected"] {
    color: #a5b4fc;
    font-style: normal;
    font-weight: 600;
}

QLabel#summaryLabel[state="device"] {
    color: #34d399;
    font-style: normal;
    font-weight: 600;
}

QLabel#summaryLabel[state="empty"] {
    color: #475569;
    font-style: italic;
}

/* === CAMPI NEL SUMMARY FRAME === */
QFrame#summaryFrame QComboBox,
QFrame#summaryFrame QComboBox:disabled,
QFrame#summaryFrame QLineEdit,
QFrame#summaryFrame QLineEdit:disabled,
QFrame#summaryFrame QDoubleSpinBox,
QFrame#summaryFrame QDoubleSpinBox:disabled,
QFrame#summaryFrame QSpinBox,
QFrame#summaryFrame QSpinBox:disabled,
QFrame#summaryFrame QTextEdit,
QFrame#summaryFrame QTextEdit:disabled {
    background-color: transparent !important;
    background: transparent !important;
    border: 1px solid #253352;
    border-radius: 10px;
    font-size: 14px;
    padding: 7px 12px;
    margin: 0px !important;
}

QFrame#summaryFrame QComboBox:focus,
QFrame#summaryFrame QLineEdit:focus,
QFrame#summaryFrame QDoubleSpinBox:focus,
QFrame#summaryFrame QSpinBox:focus,
QFrame#summaryFrame QTextEdit:focus {
    background-color: transparent !important;
    background: transparent !important;
    border: 2px solid #818cf8;
    border-radius: 10px;
    padding: 6px 11px;
}

QFrame#summaryFrame QComboBox:hover,
QFrame#summaryFrame QLineEdit:hover,
QFrame#summaryFrame QDoubleSpinBox:hover,
QFrame#summaryFrame QSpinBox:hover,
QFrame#summaryFrame QTextEdit:hover {
    background-color: transparent !important;
    background: transparent !important;
    border: 1px solid #3a4f72;
    border-radius: 10px;
    padding: 7px 12px;
}

QFrame#summaryFrame QComboBox::drop-down {
    background-color: transparent !important;
    background: transparent !important;
    border: none !important;
}

/* === PULSANTI AZIONE HOME (summaryRole globale) â€” DARK === */
QPushButton[summaryRole="electrical"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(59, 130, 246, 0.22),
                                stop:1 rgba(37, 99, 235, 0.18));
    color: #93c5fd;
    border: 2px solid rgba(96, 165, 250, 0.40);
    border-radius: 14px;
    font-weight: 700;
    padding: 10px 18px;
}

QPushButton[summaryRole="electrical"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(59, 130, 246, 0.35),
                                stop:1 rgba(37, 99, 235, 0.28));
    border-color: rgba(96, 165, 250, 0.65);
}

QPushButton[summaryRole="electrical"]:pressed {
    background: rgba(37, 99, 235, 0.35);
    border-color: #60a5fa;
}

QPushButton[summaryRole="electrical"]:disabled {
    background: rgba(30, 41, 59, 0.50);
    color: #475569;
    border-color: rgba(51, 71, 102, 0.50);
}

QPushButton[summaryRole="functional"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.22),
                                stop:1 rgba(5, 150, 105, 0.18));
    color: #6ee7b7;
    border: 2px solid rgba(52, 211, 153, 0.40);
    border-radius: 14px;
    font-weight: 700;
    padding: 10px 18px;
}

QPushButton[summaryRole="functional"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16, 185, 129, 0.35),
                                stop:1 rgba(5, 150, 105, 0.28));
    border-color: rgba(52, 211, 153, 0.65);
}

QPushButton[summaryRole="functional"]:pressed {
    background: rgba(5, 150, 105, 0.35);
    border-color: #34d399;
}

QPushButton[summaryRole="functional"]:disabled {
    background: rgba(30, 41, 59, 0.50);
    color: #475569;
    border-color: rgba(51, 71, 102, 0.50);
}

QLabel#summaryCaptionLabel {
    color: #9fb0c8;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
}

QFrame#summaryFrame QPushButton {
    border-radius: 14px;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 14px;
}

QFrame#summaryFrame QPushButton[summaryRole="neutral"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(99,102,241,0.20),
                                stop:1 rgba(79,70,229,0.30));
    color: #c7d2fe;
    border: 1px solid #818cf8;
}

QFrame#summaryFrame QPushButton[summaryRole="neutral"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(129,140,248,0.24),
                                stop:1 rgba(99,102,241,0.36));
    border: 1px solid #a5b4fc;
}

QFrame#summaryFrame QPushButton[summaryRole="electrical"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(59,130,246,0.22),
                                stop:1 rgba(37,99,235,0.30));
    color: #bfdbfe;
    border: 1px solid #3b82f6;
}

QFrame#summaryFrame QPushButton[summaryRole="electrical"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(96,165,250,0.28),
                                stop:1 rgba(59,130,246,0.36));
    border: 1px solid #60a5fa;
}

QFrame#summaryFrame QPushButton[summaryRole="functional"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(16,185,129,0.20),
                                stop:1 rgba(5,150,105,0.28));
    color: #a7f3d0;
    border: 1px solid #34d399;
}

QFrame#summaryFrame QPushButton[summaryRole="functional"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(52,211,153,0.24),
                                stop:1 rgba(16,185,129,0.34));
    border: 1px solid #6ee7b7;
}

/* === CHECKBOX === */
QCheckBox {
    color: #eef2ff;
    spacing: 10px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #3a4f72;
    border-radius: 6px;
    background-color: #131c2e;
}

QCheckBox::indicator:hover {
    border: 2px solid #818cf8;
    background-color: #1a2540;
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border: 2px solid #6366f1;
}

QCheckBox::indicator:checked:hover {
    background-color: #818cf8;
    border: 2px solid #818cf8;
}

QCheckBox::indicator:disabled {
    background-color: #1a2540;
    border: 2px solid #253352;
}

/* === RADIO BUTTON === */
QRadioButton {
    color: #eef2ff;
    spacing: 10px;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #3a4f72;
    border-radius: 10px;
    background-color: #131c2e;
}

QRadioButton::indicator:hover {
    border-color: #818cf8;
}

QRadioButton::indicator:checked {
    border-color: #6366f1;
    background-color: #6366f1;
}

/* === PROGRESS BAR === */
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #253352;
    height: 14px;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: #cbd5e1;
}

QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #6366f1, stop: 1 #818cf8);
    border-radius: 8px;
}

/* === OVERLAY WIDGET === */
OverlayWidget QLabel {
    color: #ffffff !important;
    font-size: 18px;
    font-weight: 700;
    background-color: rgba(12, 18, 34, 0.96);
    border: 1px solid #253352;
    padding: 14px 28px;
    border-radius: 14px;
}

OverlayWidget QLabel#overlayMessageLabel {
    color: #ffffff !important;
    font-size: 18px;
    font-weight: 700;
    background-color: rgba(12, 18, 34, 0.96);
    border: 1px solid #253352;
    padding: 14px 28px;
    border-radius: 14px;
}

/* === EMBEDDED VIEW HEADER === */
QFrame#embeddedViewHeader {
    background-color: #1a2540;
    border-bottom: 1px solid #253352;
}

/* === CHANGELOG DIALOG === */
QFrame#changelogVersionFrame {
    border: 1px solid #253352;
    border-radius: 14px;
    background-color: #1a2540;
    padding: 18px;
}

QLabel#changelogVersionTitle {
    color: #a5b4fc;
    font-weight: 700;
}

/* === TOOLTIP === */
QToolTip {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
}

/* === STATUSBAR === */
QStatusBar {
    background-color: #0c1222;
    border-top: 1px solid #253352;
    padding: 4px 12px;
    font-size: 12px;
    color: #7c8da5;
    min-height: 28px;
}

QStatusBar::item {
    border: none;
}

/* === SPLITTER === */
QSplitter::handle {
    background-color: #253352;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #818cf8;
}

QSplitter::handle:horizontal {
    width: 5px;
    margin: 0 1px;
}

QSplitter::handle:vertical {
    height: 5px;
    margin: 1px 0;
}

/* === MESSAGE BOX === */
QMessageBox {
    background-color: #131c2e;
}

QMessageBox QLabel {
    color: #eef2ff;
    font-size: 14px;
}

/* === WIZARD === */
QWizard {
    background-color: #0c1222;
}

QWizardPage {
    background-color: #0c1222;
}

/* === DIALOG BUTTONS === */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QDialogButtonBox QPushButton {
    min-width: 90px;
    margin: 3px;
}

/* === TESTO PULSANTI SEMPRE BOLD === */
QPushButton,
QToolButton,
QDialogButtonBox QPushButton {
    font-weight: 700;
}

/* --- Fix coerenza dimensioni pulsanti azione --- */
QPushButton#autoButton,
QPushButton#editButton,
QPushButton#secondaryButton,
QPushButton#warningButton,
QPushButton#deleteButton {
    min-height: 38px;
    min-width: 90px;
    padding: 10px 20px;
    border-radius: 10px;
}

QPushButton#autoButton:hover,
QPushButton#autoButton:pressed,
QPushButton#autoButton:focus,
QPushButton#editButton:hover,
QPushButton#editButton:pressed,
QPushButton#editButton:focus,
QPushButton#secondaryButton:hover,
QPushButton#secondaryButton:pressed,
QPushButton#secondaryButton:focus,
QPushButton#warningButton:hover,
QPushButton#warningButton:pressed,
QPushButton#warningButton:focus,
QPushButton#deleteButton:hover,
QPushButton#deleteButton:pressed,
QPushButton#deleteButton:focus {
    padding: 10px 20px;
}

/* I pulsanti icon-only della home non devono ereditare dimensioni da quelli testuali */
QPushButton[homeIconButton="true"],
QPushButton[homeIconButton="true"]:hover,
QPushButton[homeIconButton="true"]:pressed,
QPushButton[homeIconButton="true"]:focus,
QPushButton[homeIconButton="true"]:checked {
    min-width: 38px;
    min-height: 38px;
    max-width: 40px;
    max-height: 40px;
    padding: 0px;
    border-radius: 12px;
}

/* Selezione tabelle uniforme per leggibilitÃ  righe */
QTableWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:alternate:selected,
QTableView::item:alternate:selected,
QTableWidget::item:hover:selected,
QTableView::item:hover:selected,
QTableWidget#deviceTable::item:selected,
QTableWidget#deviceTable::item:hover:selected {
    background-color: rgba(99, 102, 241, 0.35);
    color: #ffffff;
    font-weight: 700;
}

/* === DASHBOARD STATISTICHE === */
QDialog#statsDashboardDialog {
    background-color: #0c1222;
}

QDialog#statsDashboardDialog QLabel#statsDashboardTitle {
    color: #f1f5f9;
    font-size: 22px;
    font-weight: 800;
}

QDialog#statsDashboardDialog QTabWidget#statsTabs::pane {
    border: 1px solid #253352;
    border-radius: 14px;
    background: #131c2e;
}

QDialog#statsDashboardDialog QTabBar::tab {
    min-width: 120px;
    padding: 10px 18px;
}

QDialog#statsDashboardDialog QChartView {
    border: 1px solid #253352;
    border-radius: 12px;
    background-color: #0f1728;
}

QDialog#statsDashboardDialog QTableWidget {
    border: 1px solid #253352;
    border-radius: 12px;
}

QDialog#statsDashboardDialog QGroupBox {
    padding-top: 12px;
}

QDialog#statsDashboardDialog QTableWidget::item {
    padding: 8px 10px;
}

QDialog#statsDashboardDialog QListWidget {
    border: 1px solid #253352;
    border-radius: 12px;
    background: #0f1728;
}

QDialog#statsDashboardDialog QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QDialog#statsDashboardDialog QListWidget::item:hover {
    background: #1a2540;
}

/* === ANTEPRIMA STAMPA === */
QPrintPreviewDialog#printPreviewDialog {
    background-color: #0c1222;
}

QPrintPreviewDialog#printPreviewDialog QToolBar {
    background-color: #131c2e;
    border-bottom: 1px solid #253352;
    spacing: 6px;
    padding: 6px 8px;
}

QPrintPreviewDialog#printPreviewDialog QToolButton {
    background-color: #1a2540;
    color: #cbd5e1;
    border: 1px solid #253352;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 24px;
    min-width: 38px;
    font-weight: 600;
}

QPrintPreviewDialog#printPreviewDialog QToolButton:hover {
    background-color: #253352;
    border-color: #3a4f72;
}

QPrintPreviewDialog#printPreviewDialog QToolButton:checked {
    background-color: #6366f1;
    border-color: #6366f1;
    color: #ffffff;
}

QPrintPreviewDialog#printPreviewDialog QToolButton:pressed {
    background-color: rgba(99, 102, 241, 0.3);
    border-color: #4f46e5;
}

QPrintPreviewDialog#printPreviewDialog QLineEdit,
QPrintPreviewDialog#printPreviewDialog QComboBox {
    background-color: #0f1728;
    border: 1px solid #253352;
    border-radius: 8px;
    color: #eef2ff;
    padding: 6px 10px;
    min-height: 22px;
}
